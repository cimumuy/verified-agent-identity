- name: Install script dependencies
  run: |
    cd scripts
    npm install
    if [ $? -ne 0 ]; then
      echo "Failed to install dependencies"
      exit 1
    fi

- name: Step 2 - Create new Ethereum Identity
  run: |
    cd scripts
    node createNewEthereumIdentity.js || (echo "Failed to create Ethereum identity" && exit 1)

- name: Step 3 - Link Human to Agent
  run: |
    cd scripts
    node manualLinkHumanToAgent.js --challenge '{"name": "cimuy", "description": "cimuy AI Agent"}' || (echo "Failed to link human to agent" && exit 1)
